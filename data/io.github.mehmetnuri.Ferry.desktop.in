[Desktop Entry]
Name=Ferry
Comment=Move files between your computer and cloud storage
Exec=ferry %U
Icon=io.github.mehmetnuri.Ferry
Terminal=false
Type=Application
Categories=Network;FileTransfer;GTK;GNOME;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons. The list MUST also end with a semicolon.
Keywords=ferry;s3;storage;bucket;cloud;transfer;upload;minio;r2;supabase;aws;
StartupNotify=true
MimeType=x-scheme-handler/s3;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
