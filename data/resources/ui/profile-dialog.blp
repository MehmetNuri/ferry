using Gtk 4.0;
using Adw 1;

Adw.Dialog dialog {
  content-width: 560;
  content-height: 720;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("Cancel");
      }

      [end]
      Button save_button {
        label: _("Save");

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.ToastOverlay toasts {
      child: Adw.PreferencesPage {
        Adw.PreferencesGroup {
          Adw.EntryRow name_row {
            title: _("Name");
          }

          Adw.ComboRow provider_row {
            title: _("Provider");
          }
        }

        Adw.PreferencesGroup supabase_group {
          title: "Supabase";
          description: _("Create an access key under Dashboard → Storage → Settings → S3 Connection. For per-user (RLS) access: Access key = project ref, Secret = anon key, Session token = user JWT.");

          Adw.EntryRow project_ref_row {
            title: _("Project ref");
          }
        }

        Adw.PreferencesGroup {
          title: _("Server");

          Adw.EntryRow endpoint_row {
            title: _("Endpoint");
            input-purpose: url;
          }

          Adw.EntryRow region_row {
            title: _("Region");
          }

          Adw.SwitchRow path_style_row {
            title: _("Path-style addressing");
            subtitle: _("Put the bucket name in the path instead of the host name");
          }

          Adw.EntryRow remote_path_row {
            title: _("Folder (optional)");
            tooltip-text: _("The folder the connection opens in. Without one, it opens in your home folder.");
            visible: false;
          }

          Adw.ComboRow ftp_security_row {
            title: _("Encryption");
            visible: false;
          }
        }

        Adw.PreferencesGroup {
          title: _("Credentials");
          description: _("Stored in the system keyring.");

          Adw.ComboRow auth_row {
            title: _("Sign-In Method");
          }

          Adw.ComboRow aws_profile_row {
            title: _("AWS CLI Profile");
            subtitle: _("From ~/.aws/config, also with IAM Identity Center (SSO)");
            visible: false;
          }

          Adw.EntryRow access_key_row {
            title: _("Access key ID");
          }

          Adw.PasswordEntryRow secret_key_row {
            title: _("Secret access key");
          }

          Adw.PasswordEntryRow session_token_row {
            title: _("Session token (optional)");
          }

          Adw.ActionRow key_row {
            title: _("Private Key");
            subtitle: _("Optional: the SSH agent and the keys in ~/.ssh are tried first");
            subtitle-selectable: true;
            visible: false;

            [suffix]
            Button key_choose {
              icon-name: "document-open-symbolic";
              tooltip-text: _("Choose Private Key…");
              valign: center;

              styles [
                "flat",
              ]
            }

            [suffix]
            Button key_clear {
              icon-name: "edit-clear-symbolic";
              tooltip-text: _("Remove Private Key");
              valign: center;
              visible: false;

              styles [
                "flat",
              ]
            }
          }

          Adw.EntryRow jump_row {
            title: _("Jump host (optional)");
            tooltip-text: _("A server to connect through, as user@host:port, like ssh -J. Signing in to it uses the SSH agent or your keys.");
            visible: false;
          }

          Adw.EntryRow buckets_row {
            title: _("Buckets (optional, comma separated)");
            tooltip-text: _("If your credentials cannot list buckets (s3:ListAllMyBuckets), enter the bucket names they can access.");
          }
        }

        Adw.PreferencesGroup upload_group {
          title: _("Upload Defaults");
          description: _("Applied to new objects written through this connection by uploads, copies and syncs.");

          Adw.ComboRow storage_class_row {
            title: _("Storage class for uploads");
          }

          Adw.ComboRow encryption_row {
            title: _("Encryption for uploads");
          }

          Adw.EntryRow kms_key_row {
            title: _("KMS key ID or alias (optional)");
            visible: false;
          }
        }

        Adw.PreferencesGroup {
          title: _("Advanced");

          Adw.ExpanderRow role_row {
            title: _("Assume Role");
            subtitle: _("Act as an IAM role with the credentials above");
            show-enable-switch: true;
            enable-expansion: false;

            Adw.EntryRow role_arn_row {
              title: _("Role ARN");
            }

            Adw.EntryRow external_id_row {
              title: _("External ID (optional)");
            }

            Adw.EntryRow mfa_serial_row {
              title: _("MFA device ARN (optional)");
              tooltip-text: _("With an MFA device, a code from it is asked for when connecting.");
            }
          }

          Adw.SwitchRow accelerate_row {
            title: _("Transfer Acceleration");
            subtitle: _("Faster transfers over long distances through AWS edge locations. It has to be turned on for the bucket as well.");
          }

          Adw.ActionRow ca_row {
            title: _("Trusted Certificate");
            subtitle: _("System certificates only");
            subtitle-selectable: true;

            [suffix]
            Button ca_choose {
              icon-name: "document-open-symbolic";
              tooltip-text: _("Choose Certificate…");
              valign: center;

              styles [
                "flat",
              ]
            }

            [suffix]
            Button ca_clear {
              icon-name: "edit-clear-symbolic";
              tooltip-text: _("Remove Certificate");
              valign: center;
              visible: false;

              styles [
                "flat",
              ]
            }
          }
        }

        Adw.PreferencesGroup {
          Adw.ButtonRow test_row {
            title: _("Test Connection");
            start-icon-name: "network-transmit-receive-symbolic";
          }

          Adw.ActionRow test_result {
            visible: false;
            subtitle-selectable: true;
            subtitle-lines: 4;

            [prefix]
            Image test_icon {}

            [suffix]
            Button trust_button {
              label: _("Trust Certificate…");
              valign: center;
              visible: false;
            }
          }
        }
      };
    };
  };
}
