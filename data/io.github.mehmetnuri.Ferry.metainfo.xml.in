    <internet>always</internet>
  </requires>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-10-03">
      <description>
        <p>First GNOME edition, rewritten in Rust with GTK 4 and libadwaita.</p>
      </description>
    </release>
